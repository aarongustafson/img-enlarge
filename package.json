{
	"name": "@aarongustafson/img-enlarge",
	"version": "0.0.1",
	"description": "Progressively enhance images with a dialog-based enlarged view and grouped navigation.",
	"keywords": [
		"html",
		"custom element",
		"web component"
	],
	"author": "Aaron Gustafson <aaron@easy-designs.net> (https://www.aaron-gustafson.com/)",
	"license": "MIT",
	"homepage": "https://github.com/aarongustafson/img-enlarge#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aarongustafson/img-enlarge.git"
	},
	"bugs": {
		"url": "https://github.com/aarongustafson/img-enlarge/issues"
	},
	"type": "module",
	"main": "index.js",
	"module": "img-enlarge.js",
	"customElements": "custom-elements.json",
	"types": "img-enlarge.d.ts",
	"exports": {
		".": {
			"types": "./img-enlarge.d.ts",
			"import": "./index.js"
		},
		"./img-enlarge.js": {
			"types": "./img-enlarge.d.ts",
			"import": "./img-enlarge.js"
		},
		"./define.js": {
			"types": "./define.d.ts",
			"import": "./define.js"
		},
		"./custom-elements.json": "./custom-elements.json"
	},
	"files": [
		"img-enlarge.js",
		"img-enlarge.d.ts",
		"img-enlarge-styles.js",
		"define.d.ts",
		"define.js",
		"index.js",
		"custom-elements.json",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "npm@11.15.0",
	"scripts": {
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:browser": "playwright test",
		"test:types": "tsc --noEmit --strict --lib DOM,ES2022 --module NodeNext --moduleResolution NodeNext test/types.ts",
		"lint": "npm run lint:eslint && npm run lint:prettier",
		"format": "npm run format:eslint && npm run format:prettier",
		"lint:eslint": "eslint .",
		"format:eslint": "eslint . --fix",
		"lint:prettier": "prettier \"**/*.{js,ts,json,html,css,md,yml,yaml}\" --check --ignore-path .gitignore",
		"format:prettier": "prettier \"**/*.{js,ts,json,html,css,md,yml,yaml}\" --write --ignore-path .gitignore",
		"version": "node scripts/update-demo-versions.js && git add demo/esm.html",
		"postversion": "git push --follow-tags"
	},
	"devDependencies": {
		"@open-wc/eslint-config": "^13.1.0",
		"@playwright/test": "^1.65.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"happy-dom": "^21.0.4",
		"marked": "18.1.0",
		"prettier": "^3.9.9",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"microlighter": "2.2.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
